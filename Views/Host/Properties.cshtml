@using Staybnb.Models.Enums
@model List<Staybnb.Models.ViewModels.Host.HostPropertyListItem>
@{
    ViewData["Title"] = "My Properties";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count listing(s) &middot; @Model.Count(p => p.IsActive) active</p>
    <a asp-controller="HostApplication" asp-action="Apply" class="btn btn-stb btn-sm"><i class="bi bi-plus-lg me-1"></i>Add property</a>
</div>

@if (!Model.Any())
{
    <div class="stb-card text-center py-5">
        <i class="bi bi-house-add display-5 text-stb"></i>
        <p class="mt-2">You don't have any listings yet.</p>
        <a asp-controller="HostApplication" asp-action="Apply" class="btn btn-stb">List your first property</a>
    </div>
}

@foreach (var p in Model)
{
    <div class="stb-card mb-3 stb-property-row">
        <div class="row g-3">
            <div class="col-md-3 position-relative">
                @if (p.CoverImageUrl != null)
                {
                    <img src="@p.CoverImageUrl" alt="@p.Title" />
                }
                <span class="badge text-bg-light position-absolute" style="bottom:8px;left:20px"><i class="bi bi-camera"></i> @p.ImageCount</span>
            </div>
            <div class="col-md-9 d-flex flex-column">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <div>
                        <h2 class="h5 fw-semibold mb-1">@p.Title</h2>
                        <div class="stb-meta"><i class="bi bi-geo-alt"></i>@p.City, South Africa</div>
                    </div>
                    <div class="fs-5 fw-bold">R @p.PricePerNight.ToString("N2")<span class="fs-6 fw-normal text-muted">/night</span></div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-3 stb-meta mt-2">
                    <span><i class="bi bi-people"></i>@p.MaxGuests guests</span>
                    <span><i class="bi bi-door-closed"></i>@p.Bedrooms bedrooms</span>
                    <span><i class="bi bi-lamp"></i>@p.Beds beds</span>
                    <span><i class="bi bi-droplet"></i>@p.Bathrooms bathrooms</span>
                    <span class="badge rounded-pill text-bg-light">@p.PropertyType</span>

                    @if (p.ApplicationStatus == ApplicationStatus.Pending)
                    {
                        <span class="stb-badge stb-badge-pending"><i class="bi bi-hourglass-split"></i> Awaiting approval</span>
                    }
                    else if (p.ApplicationStatus == ApplicationStatus.Rejected)
                    {
                        <span class="stb-badge stb-badge-rejected"><i class="bi bi-x-circle"></i> Not approved</span>
                    }
                    else if (p.IsActive)
                    {
                        <span class="stb-badge stb-badge-active"><i class="bi bi-check-circle"></i> Active</span>
                    }
                    else
                    {
                        <span class="stb-badge stb-badge-inactive"><i class="bi bi-pause-circle"></i> Inactive</span>
                    }
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mt-auto pt-3 border-top">
                    <div class="stb-meta">
                        <div><i class="bi bi-calendar3"></i>@p.BookingCount booking(s)</div>
                        <div>
                            <i class="bi bi-star"></i>
                            @(p.ReviewCount == 0 ? "No reviews" : $"{p.AverageRating:0.0} ({p.ReviewCount} review(s))")
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Properties" asp-action="View" asp-route-id="@p.Id" class="btn btn-sm btn-outline-stb">
                            <i class="bi bi-eye"></i> View Details
                        </a>
                        <a asp-action="EditProperty" asp-route-id="@p.Id" class="btn btn-sm btn-outline-stb">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-action="ConfigureCheckIn" asp-route-propertyId="@p.Id" class="btn btn-sm btn-outline-stb">
                            <i class="bi bi-list-check"></i> Check-in rules
                        </a>
                        @if (p.CanToggle)
                        {
                            <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline">
                                @if (p.IsActive)
                                {
                                    <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-pause-fill"></i> Deactivate</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-play-fill"></i> Activate</button>
                                }
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
