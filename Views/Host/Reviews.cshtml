@model Staybnb.Models.ViewModels.Host.HostReviewsViewModel
@{
    ViewData["Title"] = "Reviews";
}

<div class="stb-card mb-4 d-flex align-items-center gap-3">
    <span class="display-6 fw-bold">@Model.AverageRating.ToString("0.0")</span>
    <div>
        <div class="stb-stars fs-5">
            @for (var i = 1; i <= 5; i++)
            {
                <i class="bi @(i <= Math.Round(Model.AverageRating) ? "bi-star-fill" : "bi-star")"></i>
            }
        </div>
        <div class="text-muted small">@Model.Reviews.Count review(s) across your listings</div>
    </div>
</div>

@if (!Model.Reviews.Any())
{
    <div class="stb-card text-center text-muted py-5">
        <i class="bi bi-star display-5"></i>
        <p class="mt-2 mb-0">No reviews yet. Guests can review a stay after it is completed.</p>
    </div>
}

@foreach (var r in Model.Reviews)
{
    <div class="stb-card mb-3">
        <div class="d-flex justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <span class="stb-avatar">@($"{r.Reviewer.FirstName.FirstOrDefault()}{r.Reviewer.LastName.FirstOrDefault()}".ToUpper())</span>
                <div>
                    <div class="fw-semibold">@r.Reviewer.FullName</div>
                    <div class="small text-muted">@r.Property.Title &middot; @r.CreatedAt.ToLocalTime().ToString("MMMM yyyy")</div>
                </div>
            </div>
            <div class="stb-stars">
                @for (var i = 1; i <= 5; i++)
                {
                    <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star")"></i>
                }
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(r.Comment))
        {
            <p class="mt-3 mb-0">@r.Comment</p>
        }
    </div>
}
