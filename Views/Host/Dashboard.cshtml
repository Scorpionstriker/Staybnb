@model Staybnb.Models.ViewModels.Host.HostDashboardViewModel
@{
    ViewData["Title"] = "Host Dashboard";
}

<div class="stb-card mb-4">
    <h2 class="h4 fw-bold text-stb mb-1">Welcome back, @Model.HostFirstName!</h2>
    <p class="text-muted mb-3">Here's what's happening with your properties today.</p>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="HostApplication" asp-action="Apply" class="btn btn-outline-stb btn-sm"><i class="bi bi-plus-lg me-1"></i>Add New Property</a>
        <a asp-action="BookingRequests" class="btn btn-outline-stb btn-sm"><i class="bi bi-calendar-check me-1"></i>View Booking Requests</a>
        <a asp-action="Earnings" class="btn btn-outline-stb btn-sm"><i class="bi bi-graph-up me-1"></i>View Earnings Report</a>
    </div>
</div>

@if (Model.PendingRequests > 0 || Model.CheckInsToReview > 0 || Model.PendingApplications > 0)
{
    <div class="d-flex flex-column gap-2 mb-4">
        @if (Model.PendingRequests > 0)
        {
            <a asp-action="BookingRequests" asp-route-filter="pending" class="alert alert-warning mb-0 text-decoration-none d-flex align-items-center gap-2">
                <i class="bi bi-hourglass-split"></i>
                <span>You have <strong>@Model.PendingRequests</strong> booking request(s) waiting for your response.</span>
                <i class="bi bi-chevron-right ms-auto"></i>
            </a>
        }
        @if (Model.CheckInsToReview > 0)
        {
            <a asp-action="CheckIns" class="alert alert-info mb-0 text-decoration-none d-flex align-items-center gap-2">
                <i class="bi bi-person-vcard"></i>
                <span><strong>@Model.CheckInsToReview</strong> guest check-in(s) need document verification.</span>
                <i class="bi bi-chevron-right ms-auto"></i>
            </a>
        }
        @if (Model.PendingApplications > 0)
        {
            <a asp-controller="HostApplication" asp-action="Status" class="alert alert-secondary mb-0 text-decoration-none d-flex align-items-center gap-2">
                <i class="bi bi-clipboard-check"></i>
                <span><strong>@Model.PendingApplications</strong> property application(s) are waiting for admin approval.</span>
                <i class="bi bi-chevron-right ms-auto"></i>
            </a>
        }
    </div>
}

@* ---------- Stat tiles ---------- *@
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stb-stat">
            <span class="stb-stat-icon stb-icon-blue"><i class="bi bi-house"></i></span>
            <div class="stb-stat-value">@Model.TotalProperties</div>
            <div class="stb-stat-label">Total Properties</div>
            <div class="small text-success mt-1"><i class="bi bi-check-circle"></i> @Model.ActiveProperties active</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stb-stat">
            <span class="stb-stat-icon stb-icon-purple"><i class="bi bi-calendar3"></i></span>
            <div class="stb-stat-value">@Model.TotalBookings</div>
            <div class="stb-stat-label">Total Bookings</div>
            <div class="small text-muted mt-1">@Model.BookingsThisMonth this month</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stb-stat">
            <span class="stb-stat-icon stb-icon-green"><i class="bi bi-cash-stack"></i></span>
            <div class="stb-stat-value">R @Model.TotalEarnings.ToString("N0")</div>
            <div class="stb-stat-label">Total Earnings</div>
            <div class="small text-muted mt-1">R @Model.EarningsThisMonth.ToString("N0") this month</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stb-stat">
            <span class="stb-stat-icon stb-icon-orange"><i class="bi bi-star-fill"></i></span>
            <div class="stb-stat-value">@Model.AverageRating.ToString("0.0")</div>
            <div class="stb-stat-label">Average Rating</div>
            <div class="small text-muted mt-1">@Model.ReviewCount review(s)</div>
        </div>
    </div>
</div>

@* ---------- Performance ---------- *@
<div class="stb-card mb-4">
    <h3 class="h6 fw-bold mb-3">Performance Metrics</h3>
    <div class="row g-3 text-center">
        <div class="col-6 col-md-3">
            <div class="fs-4 fw-bold text-stb">@Model.OccupancyRateThisMonth.ToString("0.#")%</div>
            <div class="stb-stat-label">Occupancy this month</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="fs-4 fw-bold text-stb">@Model.AcceptanceRate.ToString("0.#")%</div>
            <div class="stb-stat-label">Acceptance rate</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="fs-4 fw-bold text-stb">R @Model.AverageBookingValue.ToString("N0")</div>
            <div class="stb-stat-label">Avg. booking value</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="fs-4 fw-bold text-stb">@Model.PendingRequests</div>
            <div class="stb-stat-label">Pending requests</div>
        </div>
    </div>
</div>

<div class="row g-4">
    @* ---------- Pending requests ---------- *@
    <div class="col-lg-6">
        <div class="stb-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="h6 fw-bold mb-0">Pending Requests</h3>
                <a asp-action="BookingRequests" class="small fw-semibold text-dark">View all</a>
            </div>
            @if (!Model.PendingBookingRequests.Any())
            {
                <p class="text-muted small mb-0">No requests waiting. Nice work!</p>
            }
            else
            {
                foreach (var b in Model.PendingBookingRequests)
                {
                    <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                        <span class="stb-avatar">@($"{b.Guest.FirstName.FirstOrDefault()}{b.Guest.LastName.FirstOrDefault()}".ToUpper())</span>
                        <div class="flex-grow-1 small">
                            <div class="fw-semibold">@b.Guest.FullName</div>
                            <div class="text-muted">@b.Property.Title &middot; @b.CheckInDate.ToString("dd MMM") - @b.CheckOutDate.ToString("dd MMM") &middot; @b.NumberOfGuests guest(s)</div>
                        </div>
                        <div class="text-end small fw-semibold">R @b.TotalPrice.ToString("N0")</div>
                    </div>
                }
            }
        </div>
    </div>

    @* ---------- Upcoming stays ---------- *@
    <div class="col-lg-6">
        <div class="stb-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="h6 fw-bold mb-0">Upcoming Stays</h3>
                <a asp-action="BookingRequests" asp-route-filter="upcoming" class="small fw-semibold text-dark">View all</a>
            </div>
            @if (!Model.UpcomingStays.Any())
            {
                <p class="text-muted small mb-0">No upcoming stays yet.</p>
            }
            else
            {
                foreach (var b in Model.UpcomingStays)
                {
                    <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                        <div class="text-center" style="width:48px">
                            <div class="fw-bold">@b.CheckInDate.ToString("dd")</div>
                            <div class="small text-muted text-uppercase">@b.CheckInDate.ToString("MMM")</div>
                        </div>
                        <div class="flex-grow-1 small">
                            <div class="fw-semibold">@b.Guest.FullName</div>
                            <div class="text-muted">@b.Property.Title &middot; @b.Nights night(s)</div>
                        </div>
                        <span class="stb-badge stb-badge-@b.Status.ToString().ToLowerInvariant()">@b.Status</span>
                    </div>
                }
            }
        </div>
    </div>
</div>
