@using Staybnb.Models.Enums
@using Staybnb.Services
@model Staybnb.Models.ViewModels.Guest.CheckInWizardViewModel
@{
    var c = Model.CheckIn;
    var booking = c.Booking;
    var step = Model.CurrentStep;
    ViewData["Title"] = "Online check-in";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id" class="text-dark text-decoration-none fw-semibold">
            <i class="bi bi-chevron-left"></i> Back to booking
        </a>

        <h1 class="h3 fw-bold mt-2 mb-1">Online check-in</h1>
        <p class="text-muted">
            @booking.Property.Title &middot; @booking.CheckInDate.ToString("dd MMM") - @booking.CheckOutDate.ToString("dd MMM yyyy")
        </p>

        @* ---------- Progress ---------- *@
        <div class="d-flex justify-content-between small fw-semibold mb-1">
            <span>@(Model.IsSubmitted ? "All steps complete" : $"Step {c.CurrentStep} of {Model.TotalSteps}")</span>
            <span>@Model.ProgressPercent%</span>
        </div>
        <div class="progress mb-4" style="height:8px" role="progressbar" aria-valuenow="@Model.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width:@(Model.ProgressPercent)%;background:var(--stb-primary)"></div>
        </div>

        <div class="row g-4">
            @* ---------- Step list ---------- *@
            <div class="col-md-4">
                <div class="list-group">
                    @foreach (var s in Model.Steps)
                    {
                        var done = Model.IsSubmitted || s.StepNumber < c.CurrentStep;
                        var isCurrent = !Model.IsSubmitted && s.StepNumber == c.CurrentStep;
                        <div class="list-group-item d-flex align-items-center gap-2 @(isCurrent ? "fw-semibold" : "")">
                            @if (done)
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                            else if (isCurrent)
                            {
                                <i class="bi bi-arrow-right-circle-fill text-stb"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle text-muted"></i>
                            }
                            <span class="small">@s.Title</span>
                            @if (done && !Model.IsSubmitted)
                            {
                                <form asp-action="Back" method="post" class="ms-auto">
                                    <input type="hidden" name="bookingId" value="@booking.Id" />
                                    <input type="hidden" name="stepNumber" value="@s.StepNumber" />
                                    <button type="submit" class="btn btn-link btn-sm p-0 text-dark" title="Edit this step"><i class="bi bi-pencil"></i></button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>

            @* ---------- Current step / result ---------- *@
            <div class="col-md-8">
                @if (c.Status == CheckInStatus.Verified)
                {
                    <div class="stb-card text-center py-5">
                        <i class="bi bi-door-open display-4 text-success"></i>
                        <h2 class="h4 fw-semibold mt-3">You're checked in!</h2>
                        <p class="text-muted mb-0">@booking.Property.Host.FirstName verified your documents. Enjoy your stay at @booking.Property.Title.</p>
                    </div>
                }
                else if (c.Status == CheckInStatus.Submitted)
                {
                    <div class="stb-card">
                        <div class="text-center py-3">
                            <i class="bi bi-hourglass-split display-5 text-warning"></i>
                            <h2 class="h5 fw-semibold mt-3">Waiting for the Host to verify your documents</h2>
                            <p class="text-muted">You'll get a notification once @booking.Property.Host.FirstName has checked them.</p>
                        </div>
                        <h3 class="h6 fw-semibold">Your documents</h3>
                        <ul class="list-unstyled small mb-0">
                            @foreach (var d in c.Documents)
                            {
                                <li class="d-flex justify-content-between align-items-center py-2 border-top">
                                    <span><i class="bi bi-file-earmark-person me-1"></i>@d.DocumentType</span>
                                    <span>
                                        <span class="stb-badge stb-badge-@d.Status.ToString().ToLowerInvariant()">@d.Status</span>
                                        <a asp-controller="Documents" asp-action="Open" asp-route-id="@d.Id" target="_blank" class="ms-2">View</a>
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                }
                else if (step != null)
                {
                    var isLast = step.StepNumber == Model.Steps.Max(s => s.StepNumber);

                    <div class="stb-card">
                        @if (c.Status == CheckInStatus.Rejected && Model.CurrentDocument?.Status == DocumentStatus.Rejected)
                        {
                            <div class="alert alert-danger small">
                                <i class="bi bi-exclamation-triangle"></i>
                                The Host could not accept your @Model.CurrentDocument.DocumentType: <strong>@Model.CurrentDocument.RejectionReason</strong>
                                Please upload a new one.
                            </div>
                        }

                        <div class="small text-muted mb-1">Step @step.StepNumber of @Model.TotalSteps</div>
                        <h2 class="h4 fw-semibold">@step.Title</h2>
                        @if (!string.IsNullOrWhiteSpace(step.Instructions))
                        {
                            <p style="white-space: pre-line">@step.Instructions</p>
                        }

                        <form asp-action="Step" method="post" enctype="multipart/form-data" class="mt-3" id="stepForm">
                            <input type="hidden" name="bookingId" value="@booking.Id" />
                            <input type="hidden" name="stepNumber" value="@step.StepNumber" />

                            @if (step.RequiresDocument)
                            {
                                var docType = CheckInService.DocumentTypeFor(step);
                                var hasUsable = Model.CurrentDocument != null && Model.CurrentDocument.Status != DocumentStatus.Rejected;

                                <div class="mb-3">
                                    <label class="form-label fw-semibold" for="documentType">Which document are you uploading?</label>
                                    <select class="form-select" id="documentType" name="documentType">
                                        <option value="South African ID">South African ID (card or book)</option>
                                        <option value="Passport">Passport</option>
                                        <option value="Driver's licence">Driver's licence</option>
                                    </select>
                                </div>

                                if (hasUsable)
                                {
                                    <div class="alert alert-success small">
                                        <i class="bi bi-check-circle"></i> Your @docType is uploaded
                                        (<a asp-controller="Documents" asp-action="Open" asp-route-id="@Model.CurrentDocument!.Id" target="_blank">view</a>).
                                        You can continue, or choose a new file to replace it.
                                    </div>
                                }

                                <div class="mb-3">
                                    <label class="form-label fw-semibold" for="document">Upload your @docType @(hasUsable ? "(optional)" : "")</label>
                                    <input type="file" class="form-control" id="document" name="document" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" required="@(!hasUsable)" />
                                    <div class="form-text">PDF, JPG or PNG, max 10 MB. Make sure your name and photo are clearly visible. Only the Host of this property can see it.</div>
                                </div>
                            }
                            else
                            {
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" value="true" id="acknowledged" name="acknowledged" required />
                                    <label class="form-check-label" for="acknowledged">I have read and agree to this step.</label>
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center border-top pt-3">
                                <span class="small text-muted">@(isLast ? "This is the last step." : "")</span>
                                <button type="submit" class="btn btn-stb px-4">
                                    @(isLast ? "Submit check-in" : "Continue")
                                </button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
