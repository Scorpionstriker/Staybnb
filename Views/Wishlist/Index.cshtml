@model Staybnb.Models.ViewModels.Guest.WishlistViewModel
@{
    ViewData["Title"] = "Wishlist";
}

<div class="py-4">
    <h1 class="h3 fw-bold mb-4">Wishlist</h1>

    @if (!Model.Properties.Any())
    {
        <div class="stb-card text-center py-5">
            <i class="bi bi-heart display-5 text-stb"></i>
            <h2 class="h5 fw-semibold mt-3">Create your first wishlist</h2>
            <p class="text-muted">As you search, click the heart icon to save your favourite places.</p>
            <a asp-controller="Properties" asp-action="Index" class="btn btn-outline-stb">Start exploring</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var card in Model.Properties)
            {
                <div class="col">
                    <partial name="_PropertyCard" model="card" />
                </div>
            }
        </div>
    }
</div>
