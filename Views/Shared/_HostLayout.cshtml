@using Microsoft.AspNetCore.Identity
@using Staybnb.Models.Entities
@using Staybnb.Services.Interfaces
@inject UserManager<ApplicationUser> UserManager
@inject INotificationService Notifications
@inject IMessageService Messages
@{
    var hostUser = await UserManager.GetUserAsync(User);
    var unreadCount = hostUser == null ? 0 : await Notifications.GetUnreadCountAsync(hostUser.Id);
    var unreadMessages = hostUser == null ? 0 : await Messages.GetUnreadCountAsync(hostUser.Id);
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var initials = hostUser == null ? "?" : $"{hostUser.FirstName.FirstOrDefault()}{hostUser.LastName.FirstOrDefault()}".ToUpper();

    // Sidebar items: (label, icon, controller, action, also-active-for actions)
    var menu = new (string Label, string Icon, string Controller, string Action, string[] Also)[]
    {
        ("Dashboard", "bi-speedometer2", "Host", "Dashboard", Array.Empty<string>()),
        ("My Properties", "bi-house-door", "Host", "Properties", new[] { "EditProperty" }),
        ("Booking Requests", "bi-calendar-check", "Host", "BookingRequests", Array.Empty<string>()),
        ("Check-ins", "bi-person-vcard", "Host", "CheckIns", new[] { "ReviewCheckIn" }),
        ("Check-in Rules", "bi-list-check", "Host", "ConfigureCheckIn", Array.Empty<string>()),
        ("Earnings", "bi-cash-coin", "Host", "Earnings", Array.Empty<string>()),
        ("Reviews", "bi-star", "Host", "Reviews", Array.Empty<string>()),
        ("Messages", "bi-envelope", "Messages", "Index", new[] { "Conversation" }),
        ("Notifications", "bi-bell", "Notifications", "Index", Array.Empty<string>())
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staybnb Host</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <partial name="_StaybnbAssets" />
</head>
<body class="stb-dashboard-body">
    <div class="stb-dashboard">
        @* Sidebar *@
        <aside class="stb-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="hostSidebar" aria-labelledby="hostSidebarLabel">
            <div class="offcanvas-header d-lg-none">
                <span class="offcanvas-title fw-bold text-stb" id="hostSidebarLabel">staybnb host</span>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#hostSidebar" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0 w-100">
                <a asp-controller="Host" asp-action="Dashboard" class="stb-brand d-none d-lg-flex">
                    <i class="bi bi-house-heart-fill"></i> staybnb <span class="fw-normal">host</span>
                </a>
                <nav class="stb-side-nav flex-grow-1">
                    @foreach (var item in menu)
                    {
                        var isActive = string.Equals(currentController, item.Controller, StringComparison.OrdinalIgnoreCase)
                                       && (string.Equals(currentAction, item.Action, StringComparison.OrdinalIgnoreCase)
                                           || item.Also.Contains(currentAction, StringComparer.OrdinalIgnoreCase));
                        <a asp-controller="@item.Controller" asp-action="@item.Action" class="stb-side-link @(isActive ? "active" : "")">
                            <i class="bi @item.Icon"></i>
                            <span>@item.Label</span>
                            @if (item.Label == "Notifications" && unreadCount > 0)
                            {
                                <span class="badge rounded-pill bg-primary ms-auto">@unreadCount</span>
                            }
                            @if (item.Label == "Messages" && unreadMessages > 0)
                            {
                                <span class="badge rounded-pill bg-primary ms-auto">@unreadMessages</span>
                            }
                        </a>
                    }
                    <a asp-controller="HostApplication" asp-action="Apply" class="stb-side-link">
                        <i class="bi bi-plus-circle"></i><span>Add a property</span>
                    </a>
                </nav>
                <form asp-controller="Account" asp-action="Logout" method="post" class="p-3">
                    <button type="submit" class="stb-side-link text-danger border-0 bg-transparent w-100">
                        <i class="bi bi-box-arrow-right"></i><span>Logout</span>
                    </button>
                </form>
            </div>
        </aside>

        @* Main *@
        <div class="stb-main">
            <header class="stb-topbar">
                <button class="btn btn-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#hostSidebar" aria-controls="hostSidebar" aria-label="Open menu">
                    <i class="bi bi-list"></i>
                </button>
                <h1 class="stb-topbar-title">@(ViewData["PageHeading"] ?? ViewData["Title"])</h1>
                <div class="d-flex align-items-center gap-3">
                    <a asp-controller="Messages" asp-action="Index" class="text-dark fs-5 position-relative" title="Messages">
                        <i class="bi bi-envelope"></i>
                        @if (unreadMessages > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary" style="font-size:.6rem">@unreadMessages</span>
                        }
                    </a>
                    <a asp-controller="Notifications" asp-action="Index" class="text-dark fs-5 position-relative" title="Notifications">
                        <i class="bi bi-bell"></i>
                        @if (unreadCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary" style="font-size:.6rem">@unreadCount</span>
                        }
                    </a>
                    <div class="dropdown">
                        <button class="btn stb-user-pill dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="stb-avatar" style="width:32px;height:32px;font-size:.8rem">@initials</span>
                            <span class="d-none d-sm-inline text-start lh-sm">
                                <span class="d-block fw-semibold small">@hostUser?.FullName</span>
                                <span class="d-block text-muted" style="font-size:.7rem">Host</span>
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item" asp-controller="Host" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                            <li><a class="dropdown-item" asp-controller="Host" asp-action="Properties"><i class="bi bi-house-door me-2"></i>My properties</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Index"><i class="bi bi-globe me-2"></i>View Staybnb</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="stb-content">
                <partial name="_Alerts" />
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
