@using Microsoft.AspNetCore.Identity
@using Staybnb.Models.Constants
@using Staybnb.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@* Older role-based nav links. Not used by the current layouts any more. *@
<ul class="navbar-nav align-items-lg-center">
@if (SignInManager.IsSignedIn(User))
{
    var appUser = await UserManager.GetUserAsync(User);
    var displayName = string.IsNullOrWhiteSpace(appUser?.FirstName) ? User.Identity?.Name : appUser!.FirstName;

    if (User.IsInRole(Roles.Guest))
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="HostApplication" asp-action="Status">Host Application Status</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold" asp-controller="HostApplication" asp-action="Apply">Become a Host</a>
        </li>
    }
    else if (User.IsInRole(Roles.Host))
    {
        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold" asp-controller="Host" asp-action="Dashboard">Host Dashboard</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="HostApplication" asp-action="Status">My Applications</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold" asp-controller="HostApplication" asp-action="Apply">Add a property</a>
        </li>
    }

    if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.SuperAdmin))
    {
        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold" asp-controller="Admin" asp-action="HostRequests">Host Requests</a>
        </li>
    }

    <li class="nav-item">
        <span class="nav-link text-dark">Hello @displayName!</span>
    </li>
    <li class="nav-item">
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Sign up</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Log in</a>
    </li>
}
</ul>
