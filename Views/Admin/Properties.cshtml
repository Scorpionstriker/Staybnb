@using Staybnb.Models.Enums
@model Staybnb.Models.ViewModels.Admin.AdminPropertiesViewModel
@{
    ViewData["Title"] = "Properties";
    var tabs = new[] { ("all", "All"), ("active", "Active"), ("inactive", "Inactive / suspended"), ("pending", "Awaiting approval") };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <ul class="nav stb-tabs">
        @foreach (var (key, label) in tabs)
        {
            <li class="nav-item">
                <a class="nav-link @(Model.Filter == key ? "active" : "")" asp-action="Properties" asp-route-filter="@key" asp-route-search="@Model.Search">@label</a>
            </li>
        }
    </ul>
    <form method="get" asp-action="Properties" class="d-flex gap-2">
        <input type="hidden" name="filter" value="@Model.Filter" />
        <input type="search" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Title, city or host" />
        <button type="submit" class="btn btn-sm btn-outline-stb"><i class="bi bi-search"></i></button>
    </form>
</div>

<div class="stb-card p-0 overflow-hidden">
    @if (!Model.Properties.Any())
    {
        <p class="text-center text-muted py-5 mb-0">No properties found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle stb-table mb-0">
                <thead class="table-light">
                    <tr><th class="ps-3">Property</th><th>Host</th><th>Price</th><th>Bookings</th><th>Status</th><th class="text-end pe-3">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Properties)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    @if (p.CoverImageUrl != null)
                                    {
                                        <img src="@p.CoverImageUrl" class="stb-thumb" alt="" />
                                    }
                                    <div class="small">
                                        <div class="fw-semibold">@p.Title</div>
                                        <div class="text-muted">@p.City &middot; @p.PropertyType</div>
                                    </div>
                                </div>
                            </td>
                            <td class="small"><div>@p.HostName</div><div class="text-muted">@p.HostEmail</div></td>
                            <td class="small text-nowrap">R @p.PricePerNight.ToString("N0")</td>
                            <td class="small">@p.BookingCount</td>
                            <td>
                                @if (p.ApplicationStatus == ApplicationStatus.Pending)
                                {
                                    <span class="stb-badge stb-badge-pending">Awaiting approval</span>
                                }
                                else if (p.ApplicationStatus == ApplicationStatus.Rejected)
                                {
                                    <span class="stb-badge stb-badge-rejected">Rejected</span>
                                }
                                else
                                {
                                    <span class="stb-badge @(p.IsActive ? "stb-badge-active" : "stb-badge-inactive")">@(p.IsActive ? "Active" : "Inactive")</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-inline-flex gap-1">
                                    <a asp-controller="Properties" asp-action="View" asp-route-id="@p.Id" class="btn btn-sm btn-light" title="View listing"><i class="bi bi-eye"></i></a>
                                    @if (p.ApplicationStatus is null or ApplicationStatus.Approved)
                                    {
                                        if (p.IsActive)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" type="button" data-bs-toggle="collapse" data-bs-target="#suspend-@p.Id">Suspend</button>
                                        }
                                        else
                                        {
                                            <form asp-action="ToggleProperty" asp-route-id="@p.Id" method="post">
                                                <input type="hidden" name="returnFilter" value="@Model.Filter" />
                                                <button type="submit" class="btn btn-sm btn-outline-success">Reactivate</button>
                                            </form>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                        if (p.IsActive)
                        {
                            <tr class="collapse" id="suspend-@p.Id">
                                <td colspan="6" class="bg-light">
                                    <form asp-action="ToggleProperty" asp-route-id="@p.Id" method="post" class="d-flex flex-column flex-md-row gap-2 px-3">
                                        <input type="hidden" name="returnFilter" value="@Model.Filter" />
                                        <input type="text" name="reason" class="form-control form-control-sm" maxlength="300" required
                                               placeholder="Reason sent to the Host, e.g. 'Photos don't match the property'" />
                                        <button type="submit" class="btn btn-sm btn-danger text-nowrap">Confirm suspension</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>
