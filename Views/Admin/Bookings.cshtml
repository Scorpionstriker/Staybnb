@using Staybnb.Models.Enums
@model Staybnb.Models.ViewModels.Admin.AdminBookingsViewModel
@{
    ViewData["Title"] = "Bookings";
    var total = Model.Counts.Values.Sum();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Bookings" asp-route-search="@Model.Search" class="stb-filter-chip @(Model.Status == null ? "active" : "")">All <strong>@total</strong></a>
        @foreach (var status in Enum.GetValues<BookingStatus>())
        {
            <a asp-action="Bookings" asp-route-status="@status" asp-route-search="@Model.Search"
               class="stb-filter-chip @(Model.Status == status ? "active" : "")">
                @status <strong>@(Model.Counts.TryGetValue(status, out var c) ? c : 0)</strong>
            </a>
        }
    </div>
    <form method="get" asp-action="Bookings" class="d-flex gap-2">
        @if (Model.Status.HasValue)
        {
            <input type="hidden" name="status" value="@Model.Status" />
        }
        <input type="search" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Guest, host, property, city" />
        <button type="submit" class="btn btn-sm btn-outline-stb"><i class="bi bi-search"></i></button>
    </form>
</div>

<div class="stb-card p-0 overflow-hidden">
    @if (!Model.Bookings.Any())
    {
        <p class="text-center text-muted py-5 mb-0">No bookings found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle stb-table mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">#</th>
                        <th>Guest</th>
                        <th>Property / Host</th>
                        <th>Stay</th>
                        <th class="text-end">Total</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th>Requested</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Bookings)
                    {
                        <tr>
                            <td class="ps-3 small text-muted">@b.Id</td>
                            <td class="small"><div class="fw-semibold">@b.Guest.FullName</div><div class="text-muted">@b.Guest.Email</div></td>
                            <td class="small"><div class="fw-semibold">@b.Property.Title</div><div class="text-muted">@b.Property.City &middot; host @b.Property.Host.FullName</div></td>
                            <td class="small text-nowrap">@b.CheckInDate.ToString("dd MMM yy") - @b.CheckOutDate.ToString("dd MMM yy")<br /><span class="text-muted">@b.Nights night(s), @b.NumberOfGuests guest(s)</span></td>
                            <td class="text-end small fw-semibold text-nowrap">R @b.TotalPrice.ToString("N2")</td>
                            <td><span class="stb-badge stb-badge-@b.Status.ToString().ToLowerInvariant()">@b.Status</span></td>
                            <td>
                                @if (b.Payment != null)
                                {
                                    <span class="stb-badge stb-badge-@b.Payment.Status.ToString().ToLowerInvariant()">@b.Payment.Status</span>
                                    <div class="small text-muted">@b.Payment.Reference</div>
                                }
                            </td>
                            <td class="small text-nowrap">@b.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<p class="small text-muted mt-2">Showing up to 200 most recent bookings. Bookings are managed by Hosts; this page is a read-only overview.</p>
