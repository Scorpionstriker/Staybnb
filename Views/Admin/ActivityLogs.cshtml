@using Staybnb.Models.Common
@using Staybnb.Models.Enums
@model Staybnb.Models.ViewModels.Admin.ActivityLogsViewModel
@{
    ViewData["Title"] = "Activity Logs";

    string TypeCss(ActivityType type) => type switch
    {
        ActivityType.Login or ActivityType.Logout or ActivityType.Registration => "text-bg-light",
        ActivityType.FailedLogin => "text-bg-danger",
        ActivityType.RoleChange => "text-bg-warning",
        ActivityType.BookingStatusChange => "text-bg-primary",
        ActivityType.HostApplication => "text-bg-info",
        ActivityType.DocumentVerification or ActivityType.CheckIn => "text-bg-success",
        _ => "text-bg-secondary"
    };

    var filterValues = new Dictionary<string, string?>
    {
        ["type"] = Model.Type?.ToString(),
        ["search"] = Model.Search,
        ["from"] = Model.From?.ToString("yyyy-MM-dd"),
        ["to"] = Model.To?.ToString("yyyy-MM-dd")
    };
    // Same filters for the CSV export link
    var exportRoute = filterValues.Where(kv => kv.Value != null).ToDictionary(kv => kv.Key, kv => kv.Value!);
}

<p class="text-muted small">
    System audit: every login (and failed login), role change, host application decision, booking status change and check-in verification is recorded here.
</p>

@* Filters *@
<form method="get" asp-action="ActivityLogs" class="stb-card mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold" for="type">Type</label>
            <select id="type" name="type" class="form-select form-select-sm">
                <option value="">All types</option>
                @foreach (var t in Enum.GetValues<ActivityType>())
                {
                    if (Model.Type == t)
                    {
                        <option value="@t" selected>@t</option>
                    }
                    else
                    {
                        <option value="@t">@t</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold" for="search">Search</label>
            <input id="search" type="search" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="User, email, action, details" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small fw-semibold" for="from">From</label>
            <input id="from" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small fw-semibold" for="to">To</label>
            <input id="to" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-stb flex-grow-1"><i class="bi bi-funnel"></i> Filter</button>
            <a asp-action="ActivityLogs" class="btn btn-sm btn-light" title="Clear filters"><i class="bi bi-x-lg"></i></a>
        </div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="small text-muted">@Model.TotalCount @(Model.TotalCount == 1 ? "entry" : "entries")</span>
    <a asp-action="ExportActivityLogs" asp-all-route-data="exportRoute"
       class="btn btn-sm btn-outline-stb"><i class="bi bi-download"></i> Export CSV</a>
</div>

<div class="stb-card p-0 overflow-hidden">
    @if (!Model.Logs.Any())
    {
        <p class="text-center text-muted py-5 mb-0">No log entries match these filters.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle stb-table mb-0">
                <thead class="table-light">
                    <tr><th class="ps-3">Date</th><th>User</th><th>Type</th><th>Action</th><th>Details</th><th>IP</th></tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td class="ps-3 small text-nowrap">@log.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="small">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="stb-avatar" style="width:30px;height:30px;font-size:.7rem">@DisplayHelpers.Initials(log.User)</span>
                                    <div>
                                        <div class="fw-semibold">@(log.User?.FullName ?? "System / unknown")</div>
                                        <div class="text-muted">@log.User?.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge @TypeCss(log.ActivityType)">@log.ActivityType</span></td>
                            <td class="small fw-semibold">@log.Action</td>
                            <td class="small text-muted" style="max-width:380px">@log.Details</td>
                            <td class="small text-muted">@log.IpAddress</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Log pages">
        <ul class="pagination pagination-sm justify-content-center">
            @{
                var first = Math.Max(1, Model.Page - 3);
                var last = Math.Min(Model.TotalPages, Model.Page + 3);
            }
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link text-dark" asp-action="ActivityLogs" asp-route-page="@(Model.Page - 1)" asp-route-type="@Model.Type" asp-route-search="@Model.Search"
                   asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">&laquo;</a>
            </li>
            @for (var p = first; p <= last; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link @(p == Model.Page ? "bg-dark border-dark" : "text-dark")" asp-action="ActivityLogs" asp-route-page="@p" asp-route-type="@Model.Type"
                       asp-route-search="@Model.Search" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link text-dark" asp-action="ActivityLogs" asp-route-page="@(Model.Page + 1)" asp-route-type="@Model.Type" asp-route-search="@Model.Search"
                   asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">&raquo;</a>
            </li>
        </ul>
    </nav>
}
