@{
    ViewData["Title"] = "Access denied";
}

<div class="row justify-content-center my-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="display-1 text-danger mb-3">403</div>
        <h1 class="h3 fw-semibold">You don't have access to this page</h1>
        <p class="text-muted">
            This area belongs to a different type of account.
            Guests, Hosts and Administrators each have their own pages on Staybnb.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-danger mt-2">Go to the home page</a>
    </div>
</div>
