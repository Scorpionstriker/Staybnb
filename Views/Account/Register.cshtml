@model Staybnb.Models.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Sign up";
}

<div class="row justify-content-center my-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white text-center border-bottom py-3">
                <h1 class="h5 fw-semibold mb-0">Sign up</h1>
            </div>
            <div class="card-body p-4">
                <h2 class="h4 fw-semibold mb-1">Welcome to Staybnb</h2>
                <p class="text-muted mb-4">Create an account to start exploring stays. You can apply to become a Host at any time.</p>

                <form asp-action="Register" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="form-floating">
                                <input asp-for="FirstName" class="form-control" placeholder="First name" autocomplete="given-name" />
                                <label asp-for="FirstName"></label>
                            </div>
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-floating">
                                <input asp-for="LastName" class="form-control" placeholder="Last name" autocomplete="family-name" />
                                <label asp-for="LastName"></label>
                            </div>
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-floating">
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" />
                                <label asp-for="Email"></label>
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-floating">
                                <input asp-for="PhoneNumber" class="form-control" placeholder="Phone" autocomplete="tel" />
                                <label asp-for="PhoneNumber"></label>
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-sm-6">
                            <div class="form-floating">
                                <input asp-for="Password" class="form-control" placeholder="Password" autocomplete="new-password" />
                                <label asp-for="Password"></label>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-floating">
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm password" autocomplete="new-password" />
                                <label asp-for="ConfirmPassword"></label>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <p class="form-text mt-2">
                        At least 6 characters, with an uppercase letter, a lowercase letter and a number.
                    </p>

                    <button type="submit" class="btn btn-danger w-100 py-2 mt-2 fw-semibold">Agree and continue</button>
                </form>

                <hr class="my-4" />
                <p class="text-center mb-0">
                    Already have an account?
                    <a asp-action="Login" class="fw-semibold text-dark">Log in</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
